# lingong.service 的镜像：服务器实际文件在 /etc/systemd/system/lingong.service。
# 安装：sudo cp ops/systemd/lingong.service /etc/systemd/system/ && sudo systemctl daemon-reload
# 部署不要用 systemctl restart 之外的手段：先在旧进程仍服务时构建前端，见 scripts/deploy.sh。
[Unit]
Description=Lingong KOL workbench (backend serves frontend dist on 8765)
After=network-online.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
WorkingDirectory=/home/ecs-user/kol
ExecStart=/home/ecs-user/kol/scripts/start.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
# 内存护栏：运行失控时只终止本单元（Restart=always 约 5 秒内拉起），不再把整机拖入 OOM。
MemoryHigh=1G
MemoryMax=1536M
MemorySwapMax=1G

[Install]
WantedBy=multi-user.target
