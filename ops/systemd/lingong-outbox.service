[Unit]
Description=Lingong PostgreSQL Outbox publisher
After=network-online.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
WorkingDirectory=/home/ecs-user/kol
ExecStart=/home/ecs-user/kol/scripts/worker.sh outbox
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# 内存护栏：运行失控时只终止本单元，不再危及整机。
MemoryMax=512M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
