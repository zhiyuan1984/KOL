# Codex
OPENAI_API_KEY=

# Remote MediaCrawler / Claw MCP
CLAW_MODE=remote
MEDIACRAWLER_MCP_URL=http://your-mediacrawler-host/mcp
MEDIACRAWLER_MCP_TOKEN=
# 可选：直接读取包含 /mcp 地址和 Authorization: Bearer 的 Markdown
MEDIACRAWLER_MCP_CONFIG_FILE=
MEDIACRAWLER_MCP_TIMEOUT_MS=30000
MEDIACRAWLER_POLL_INTERVAL_MS=2000
MEDIACRAWLER_MAX_CREATOR_PAGES=10
MEDIACRAWLER_CREATOR_PAGE_SIZE=100

# KOL Claw：评分、建联话术、每日任务、预算（达人主数据 / 负责人 / 状态改走 Starry KOL MCP）
KOLCLAW_MCP_URL=http://your-kol-claw-host:9093/mcp
KOLCLAW_MCP_TOKEN=
# 可选：Cursor mcpServers JSON（kol-claw url + Authorization Bearer）
KOLCLAW_MCP_CONFIG_FILE=

# Starry KOL MCP：红人库、品牌邮箱、邮件会话
# 网关要两个头：X-MCP-API-KEY（客户端）+ Authorization Bearer（Starry 用户 JWT）
STARRY_KOL_MCP_URL=https://dev-api.askstarry.com/starry/email-agent/mcp
STARRY_KOL_MCP_API_KEY=
STARRY_KOL_MCP_BEARER=
# 兼容旧名
EMAIL_MCP_URL=
EMAIL_MCP_API_KEY=
EMAIL_MCP_BEARER=
# 可选：Cursor mcpServers JSON（starry-kol-mcp 或 email-mcp）。环境变量已有的项不会被文件覆盖。
STARRY_KOL_MCP_CONFIG_FILE=

# 可选：自然语言任务识别（默认 GPT-5.6 Luna / Responses；秒级超时）
INTENT_LLM_MODEL=gpt-5.6-luna
TASK_RECOGNIZE_TIMEOUT=12
# 邮件往来摘要 analysis_failed 后自动再试冷却（毫秒，默认 5 分钟）
# MAIL_DIGEST_FAIL_RETRY_MS=300000

# Workbench
AUTH_MODE=enabled
APP_ORIGIN=
