# Codex
OPENAI_API_KEY=

# Remote MediaCrawler / Claw MCP
CLAW_MODE=remote
MEDIACRAWLER_MCP_URL=http://your-mediacrawler-host/mcp
MEDIACRAWLER_MCP_TOKEN=
# 可选：直接读取包含 /mcp 地址和 Authorization: Bearer 的 Markdown
MEDIACRAWLER_MCP_CONFIG_FILE=
MEDIACRAWLER_MCP_TIMEOUT_MS=30000
MEDIACRAWLER_POLL_INTERVAL_MS=2000
# 「检查服务」探针的单次预算（默认 8000，上限 10000）。走隧道时 4s 太紧：抖动就会把健康的采集服务报成「连接失败」。
MEDIACRAWLER_PROBE_TIMEOUT_MS=8000
# 本地监控一个采集任务的最长时间（默认 2 小时）。远程任务自己的超时是 30 分钟。
MEDIACRAWLER_MONITOR_MAX_MS=7200000
# 单个 work_item 的事件上限（默认 5000）。超出后新事件不再写入。
TASK_EVENT_MAX_PER_WORK_ITEM=5000
MEDIACRAWLER_MAX_CREATOR_PAGES=10
MEDIACRAWLER_CREATOR_PAGE_SIZE=100

# KOL Claw：评分、建联话术、每日任务、预算（达人主数据 / 负责人 / 状态改走 Starry KOL MCP）
KOLCLAW_MCP_URL=http://your-kol-claw-host:9093/mcp
KOLCLAW_MCP_TOKEN=
# 可选：Cursor mcpServers JSON（kol-claw url + Authorization Bearer）
KOLCLAW_MCP_CONFIG_FILE=

# Starry KOL：在管理侧保存连接地址并选择保险柜凭据，不再读取 MCP 环境变量或本地凭据文件。
# 保险柜主密钥属于服务部署基础设施，不是 MCP 参数。

# 可选：自然语言任务识别 / Luna 往来摘要（默认 GPT-5.6 Luna / Responses；秒级超时）
# Luna 必须设 OPENAI_BASE_URL 为 Luna 兼容端点，并用该端点的 key。
# 公共 OpenAI sk-proj-* 打默认 api.openai.com + gpt-5.6-luna 会 HTTP 401（key/endpoint 不匹配）。
# OPENAI_BASE_URL=
INTENT_LLM_MODEL=gpt-5.6-luna
# Codex 往来摘要 / 识别 thread/start 用 CODEX_MODEL 或 CLI 默认模型，不要填 gpt-5.6-luna
# CODEX_MODEL=
TASK_RECOGNIZE_TIMEOUT=12
# 邮件往来摘要 analysis_failed 后自动再试冷却（毫秒，默认 5 分钟）
# MAIL_DIGEST_FAIL_RETRY_MS=300000

# Workbench
AUTH_MODE=enabled
APP_ORIGIN=

# PostgreSQL + Redis/BullMQ（开发/测试/生产的唯一权威库；SQLite 仅作一次性迁移源）
# 本地开发：node scripts/dev-pg.mjs（--docker 起容器；--fresh 重建并迁移 data/lingong.db）。
# 生产/预发：先 `npm run db:migrate:postgres` 完成行数与指纹校验，再设置 DATABASE_URL；
# 迁移是单向操作，不要让两个存储同时承担写入真相。
# DATABASE_URL=postgresql://lingong:local-dev-only@127.0.0.1:5432/lingong_dev
# REDIS_URL=redis://127.0.0.1:6379
# SQLITE_SOURCE=/absolute/path/to/lingong.db
# EXECUTION_WORKER_CONCURRENCY=4
# Worker 领取作业的可续约 lease；运行时间超过该值仍会由 Worker 每约三分之一周期续租。
# EXECUTION_LEASE_MS=60000
# OUTBOX_POLL_MS=500
# 发布器持有 Outbox handoff 的最长时间；进程崩溃后新发布器会安全抢回超时行。
# OUTBOX_PUBLISH_LEASE_MS=60000
# PG_SYNC_TIMEOUT_MS=30000

# 凭据保险库主密钥：连接器表单里的明文密钥用它加密后入库（AES-256-GCM，配置只存引用）。
# 格式：64 位 hex 或 32 字节 base64；生成：openssl rand -hex 32。
# 缺失时：含密钥的连接器保存 / 测试 / 发现都返回 503（runtime_credential_master_key_unavailable）。
# 一经启用不要轮换——已存密文将无法解密（runtime_credential_decryption_failed）。
RUNTIME_CREDENTIAL_MASTER_KEY=
