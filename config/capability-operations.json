        "additionalProperties": false
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "getKolProfileDetail",
        "version": 1,
        "inputFields": {
          "creator_id": "kolUid"
        }
      }
    },
    {
      "id": "creator.platform_data.read",
      "version": 1,
      "name": "读取达人平台数据",
      "description": "读取达人平台数据；仅使用当前已授权对象与真实来源。不发送消息或推进正式阶段。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator_id": {
            "type": "string",
            "minLength": 1
