{
  "version": 1,
  "operations": [
    {
      "id": "creator.query",
      "version": 1,
      "name": "分页查询达人",
      "description": "在当前授权范围按可选关键词、阶段、风险条件分页查询达人；空条件读取第一页。仅返回真实来源数据，不生成联系人或合作事实。参数遵循已验证的查询接口契约。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "stage_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_tag_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page_no": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "result": {
        "kind": "paged",
        "items": [
          "list",
          "data.list",
          "records",
          "data.records"
        ],
        "total": [
          "total",
          "data.total"
        ],
        "page": [
          "pageNo",
          "data.pageNo"
        ],
        "pageSize": [
          "pageSize",
          "data.pageSize"
        ],
        "itemFields": {
          "id": [
            "kolUid"
          ],
          "record_id": ["kolId"],
          "name": [
            "kolName",
            "nickname",
            "name"
          ],
          "platform": [
            "primaryPlatformName",
            "platform",
            "primaryPlatform"
          ],
          "stage_code": [
            "currentStageCode",
            "cooperationStageCode",
            "stageCode"
          ],
          "risk_tags": [
            "riskTagCode",
            "riskTagCodes",
            "riskTags"
          ],
          "stage_name": [
            "currentStageName"
          ],
          "risk_tag_name": [
            "riskTagName"
          ],
          "owner_name": [
            "ownerName",
            "ownerUserName"
          ],
          "profile_url": [
            "homepageUrl",
            "profileUrl"
          ]
        }
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "pageKolProfiles",
        "version": 1,
        "jsonArgument": "requestJson",
        "inputFields": {
          "keyword": "keyword",
          "stage_codes": "stageCodes",
          "risk_tag_codes": "riskTagCodes",
          "page_no": "pageNo",
          "page_size": "pageSize"
        }
      }
    },
    {
      "id": "creator.query_metrics",
      "version": 1,
      "name": "查询达人统计",
      "description": "按当前授权范围读取达人查询统计；来源无法保证范围时拒绝，不将未授权全量数量返回。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "getKolProfileSidebarMetrics",
        "version": 1
      }
    },
    {
      "id": "creator.profile.read",
      "version": 1,
      "name": "读取达人档案",
      "description": "读取达人档案。仅使用当前获准范围和真实来源；缺失信息如实返回。只读，不发送、不解密、不改变阶段。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "creator_id"
        ],
        "additionalProperties": false
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "getKolProfileDetail",
        "version": 1,
        "inputFields": {
          "creator_id": "kolUid"
        }
      }
    },
    {
      "id": "creator.platform_data.read",
      "version": 1,
      "name": "读取达人平台数据",
      "description": "读取达人平台数据；仅使用当前已授权对象与真实来源。不发送消息或推进正式阶段。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "creator_id"
        ],
        "additionalProperties": false
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "listKolPlatformData",
        "version": 1,
        "inputFields": {
          "creator_id": "kolUid"
        }
      }
    },
    {
      "id": "mail.conversations.query",
      "version": 1,
      "name": "查询达人邮件会话",
      "description": "仅按已核实达人记录ID读取当前获准范围内的会话；不发送、不解密，不将邮件请求视为审批或合作事实。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator_record_id": {
            "type": "integer",
            "minimum": 1
          },
          "page_no": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "creator_record_id"
        ],
        "additionalProperties": false
      },
      "implementation": {
        "connector": "starrykol",
        "tool": "pageEmailConversations",
        "version": 1,
        "inputFields": {
          "creator_record_id": "kolId",
          "page_no": "pageNo",
          "page_size": "pageSize"
        }
      }
    }
  ]
}
