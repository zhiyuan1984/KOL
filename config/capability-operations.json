      "name": "读取达人档案",
      "description": "读取达人档案。仅使用当前获准范围和真实来源；缺失信息如实返回。只读，不发送、不解密、不改变阶段。",
      "effect": "read",
      "risk": "R1",
      "asynchronous": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator_id": {
            "type": "string",
