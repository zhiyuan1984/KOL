{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:kol:send-request",
  "type": "object",
  "required": ["draft_id", "company_id", "brand_id", "recipient", "confirmation_fingerprint"],
  "properties": {
    "draft_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "pattern": "^company:" },
    "brand_id": { "type": "string", "pattern": "^brand:" },
    "recipient": { "type": "string", "format": "email" },
    "confirmation_fingerprint": { "type": "string", "minLength": 8 }
  },
  "additionalProperties": false
}
